{
    "111": {
        "name": "Power-Up! (Evolutions)",
        "values": {
            "1": {"name": "Disabled"},
            "2": {"name": "Enabled", "tmdisplay": "Power-Up! (Evolutions)"},
            "3": {"name": "Enabled, with Mutant Evolution variant", "tmdisplay": "Power-Up! (Evolutions) with Mutant Evolution"}
        },
        "default": 1
    },
    "114": {"name": "Mindbug", "values": {"0": {"name": "Disabled"}, "1": {"name": "Enabled", "tmdisplay": "Mindbug"}}, "default": 0},
    "103": {"name": "Halloween", "values": {"1": {"name": "Disabled"}, "2": {"name": "Enabled", "tmdisplay": "Halloween"}}, "default": 1},
    "109": {
        "name": "Micro expansion : Even more wicked!",
        "values": {
            "1": {"name": "Disabled"},
            "2": {"name": "Enabled (orange side)", "tmdisplay": "Even more wicked! (orange side)"},
            "3": {"name": "Enabled (green side)", "tmdisplay": "Even more wicked! (green side)"},
            "4": {"name": "Enabled (random mix)", "tmdisplay": "Even more wicked! (random mix)"}
        },
        "default": 1
    },
    "107": {
        "name": "Monster Pack : Cthulhu (Cultists)",
        "values": {"1": {"name": "Disabled"}, "2": {"name": "Enabled", "tmdisplay": "Monster Pack : Cthulhu (Cultists)"}},
        "default": 1
    },
    "104": {
        "name": "Monster Pack : King Kong (Tokyo Tower)",
        "values": {"1": {"name": "Disabled"}, "2": {"name": "Enabled", "tmdisplay": "Monster Pack : King Kong (Tokyo Tower)"}},
        "default": 1
    },
    "108": {
        "name": "Monster Pack : Anubis (Curse cards)",
        "values": {"1": {"name": "Disabled"}, "2": {"name": "Enabled", "tmdisplay": "Monster Pack : Anubis (Curse cards)"}},
        "default": 1
    },
    "105": {
        "name": "Monster Pack : Cybertooth (Berserk)",
        "values": {"1": {"name": "Disabled"}, "2": {"name": "Enabled", "tmdisplay": "Monster Pack : Cybertooth (Berserk)"}},
        "default": 1
    },
    "106": {
        "name": "Mutant Evolutions variant (Transformation card)",
        "values": {"1": {"name": "Disabled"}, "2": {"name": "Enabled", "tmdisplay": "Mutant Evolutions variant (Transformation card)"}},
        "default": 1,
        "level": "additional"
    },
    "113": {
        "name": "Origins edition",
        "values": {"1": {"name": "Disabled"}, "2": {"name": "Enabled", "tmdisplay": "Origins edition"}},
        "default": 1,
        "startcondition": {
            "2": [
                {"type": "otheroptionisnot", "id": 112, "value": [2, 3, 4], "message": "Origins exclusive cards cannot be played with Dark Edition"},
                {"type": "maxplayers", "value": 4, "message": "King of Tokyo Origins cannot be played with more than 4 players"}
            ]
        }
    },
    "112": {
        "name": "Dark edition",
        "values": {
            "1": {"name": "Disabled"},
            "2": {"name": "Enabled (red side)", "tmdisplay": "Dark edition (red side)"},
            "3": {"name": "Enabled (green side)", "tmdisplay": "Dark edition (green side)"},
            "4": {"name": "Enabled (random mix)", "tmdisplay": "Dark edition (random mix)"}
        },
        "default": 1
    },
    "130": {
        "name": "King of Tokyo Origins exclusive cards",
        "values": {"1": {"name": "Disabled"}, "2": {"name": "Enabled", "description": "King of Tokyo Origins exclusive cards"}},
        "default": 1
    },
    "131": {
        "name": "Mindbug Power cards",
        "values": {
            "1": {"name": "Mindbug trial", "description": "Shuffle the 24 new Power cards into the King of Tokyo Power card deck."},
            "2": {
                "name": "Mindbug experience (difficult)",
                "description": "Do not use the King of Tokyo Power card deck. Instead, use only the 24 Power cards from this expansion.",
                "nobeginner": true
            }
        },
        "default": 1,
        "displaycondition": [{"type": "otheroption", "id": 114, "value": 1}]
    },
    
    "100": {
        "name": "Pick monster",
        "values": {
            "1": {"name": "Automatic", "description": "A random monster is automatically picked", "tmdisplay": "Random monster"},
            "2": {"name": "Pick", "description": "Every player chooses its monster before playing", "tmdisplay": "Players can pick a monster"}
        },
        "default": 2,
        "level": "additional"
    },
    "102": {
        "name": "Bonus monsters",
        "values": {
            "1": {"name": "Disabled", "description": "Only monsters from game version", "tmdisplay": "Only monsters from game version"},
            "2": {"name": "Enabled", "description": "Include bonus/promo monsters"}
        },
        "default": 2,
        "level": "additional"
    },
    "110": {
        "name": "Skip phase with no possible actions",
        "values": {
            "1": {"name": "Disabled", "description": "Game phases are always visible, with a timer if no possible actions"},
            "2": {"name": "Enabled", "description": "Game phases are skipped if no possible actions", "tmdisplay": "Skip phases with no possible actions"}
        },
        "default": 1,
        "nobeginner": true,
        "level": "additional"
    },
    "120": {
        "name": "2-players variant",
        "values": {"1": {"name": "Disabled"}, "2": {"name": "Enabled", "description": "When entering or starting a turn on Tokyo, you gain 1 energy instead of points"}},
        "default": 2,
        "displaycondition": [{"type": "maxplayers", "value": 2}],
        "level": "additional"
    }
